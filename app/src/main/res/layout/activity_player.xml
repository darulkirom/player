<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controls"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_timeout="4000" />

    <!-- Indikator gesture berada tepat di tengah layar, seperti player referensi -->
    <FrameLayout
        android:id="@+id/gesture_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/gesture_circle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center">
            <com.baru.player.GestureRingView
                android:id="@+id/gesture_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ImageView
                android:id="@+id/gesture_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/gesture_seek_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_indicator"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/gesture_seek_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:tint="@android:color/white" />
            <ProgressBar
                android:id="@+id/gesture_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100" />
            <TextView
                android:id="@+id/gesture_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Lapisan saat layar dikunci: ketuk untuk memunculkan tombol buka kunci -->
    <FrameLayout
        android:id="@+id/lock_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_unlock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gradient_top"
            android:contentDescription="@string/cd_buka_kunci"
            android:padding="10dp"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pill info: Locked / Unlocked / Tap to Unlock / Fit / Zoom -->
    <TextView
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>

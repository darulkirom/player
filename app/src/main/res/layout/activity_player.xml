<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controls"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_timeout="4000" />

    <!-- Lapisan saat layar dikunci: ketuk untuk memunculkan tombol buka kunci -->
    <FrameLayout
        android:id="@+id/lock_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_unlock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gradient_top"
            android:contentDescription="@string/cd_buka_kunci"
            android:padding="10dp"
            android:src="@drawable/ic_lock_open"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
